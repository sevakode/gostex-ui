+    private val gostexTrackPrefs by lazy { getSharedPreferences("gostex_series_tracks", Context.MODE_PRIVATE) }
+    private var gostexSeriesId: String? = null
+    private var gostexEndedUri: String? = null
+    private fun gostexSeriesKey(): String? {
+        val id = gostexSeriesId?.takeIf { it.isNotBlank() && it.length <= 256 } ?: return null
+        return MessageDigest.getInstance("SHA-256").digest(id.toByteArray(Charsets.UTF_8)).joinToString("") { "%02x".format(it) }
+    }
+    private fun gostexTracks(audio: Boolean): List<GostexTrack> {
+        val descriptions = (if (audio) service?.audioTracks else service?.spuTracks) ?: return emptyList()
+        val mediaTracks = getCurrentMediaTracks()
+        return descriptions.map { track ->
+            GostexTrack(track.getId(), track.getName(), mediaTracks.firstOrNull { it.id.toString() == track.getId() }?.language)
+        }
+    }
+    internal fun rememberGostexTrack(audio: Boolean, id: String) {
+        val key = gostexSeriesKey() ?: return
+        val prefix = "$key.${if (audio) "audio" else "subtitle"}"
+        val track = if (id == "-1") null else gostexTracks(audio).singleOrNull { it.id == id }
+        if (id != "-1" && track == null) return
+        gostexTrackPrefs.edit().putBoolean("$prefix.disabled", id == "-1")
+            .putString("$prefix.name", track?.name.orEmpty()).putString("$prefix.language", track?.language.orEmpty())
+            .putBoolean("$prefix.set", true).apply()
+    }
+    private val gostexTrackRestore = Runnable {
+        val key = gostexSeriesKey() ?: return@Runnable
+        val player = service ?: return@Runnable
+        for (audio in listOf(true, false)) {
+            val prefix = "$key.${if (audio) "audio" else "subtitle"}"
+            if (!gostexTrackPrefs.getBoolean("$prefix.set", false)) continue
+            val choice = GostexTrackChoice(gostexTrackPrefs.getBoolean("$prefix.disabled", false),
+                gostexTrackPrefs.getString("$prefix.name", "").orEmpty(), gostexTrackPrefs.getString("$prefix.language", ""))
+            val tracks = gostexTracks(audio)
+            val id = gostexMatchingTrack(choice, tracks)
+            if (id == null) continue
+            if (audio) player.setAudioTrack(id) else player.setSpuTrack(id)
+        }
+    }
+    private fun scheduleGostexTrackRestore() {
+        if (gostexSeriesKey() == null) return
+        handler.removeCallbacks(gostexTrackRestore)
+        handler.postDelayed(gostexTrackRestore, 800L)
+    }
