--- /dev/null
+++ b/application/vlc-android/src/org/videolan/vlc/gui/video/GostexTrackPolicy.kt
@@ -0,0 +1,20 @@
+/* Copyright (C) 2026 GOSTEX contributors. GPL-2.0-or-later. */
+package org.videolan.vlc.gui.video
+
+import java.util.Locale
+
+internal data class GostexTrack(val id: String, val name: String, val language: String?)
+internal data class GostexTrackChoice(val disabled: Boolean, val name: String, val language: String?)
+
+/** Names are more stable than stream-specific track IDs. Never guess between duplicates. */
+internal fun gostexMatchingTrack(choice: GostexTrackChoice, tracks: List<GostexTrack>): String? {
+    if (choice.disabled) return "-1"
+    fun norm(value: String?) = value?.trim()?.lowercase(Locale.ROOT).orEmpty()
+    val name = norm(choice.name)
+    if (name.isEmpty()) return null
+    val language = norm(choice.language)
+    return tracks.filter { track ->
+        track.id != "-1" && norm(track.name) == name &&
+            (language.isEmpty() || norm(track.language).isEmpty() || norm(track.language) == language)
+    }.singleOrNull()?.id
+}
